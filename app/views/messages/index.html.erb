<main class=" mt-5">
<div class="flex flex-row items-center w-full justify-between">
<h1 class="text-3xl text-orange-500 font-medium mb-2">Messages:</h1>
<div class="mb-5">
<%= form_with(url: root_path, model: @message) do |form| %>
    <div class="flex flex-row justify-self-center text-2xl gap-x-3 items-center">
        <div class="flex flex-col text-left gap-y-3">
            <%= form.label :content, "Message Content:", class:"text-orange-500 cursor-pointer" %>
            <%= form.text_field :content, required:true, autofocus:true, class:"border-1 rounded-md border-orange-500 outline-none text-white p-2" %>
        </div>
        <div class="flex flex-col text-left gap-y-3">
            <%= form.label :image,"Image (Optional):", class: "text-orange-500 cursor-pointer" %>
            <%= form.file_field :image, class:"text-orange-500 cursor-pointer" %>
        </div>
        <%= form.submit "Send", class:"rounded-md text-orange-500 text-3xl font-semibold bg-white cursor-pointer p-1" %>
    </div>
<% end %>
</div>
</div>
<div class="flex flex-col gap-y-10 w-full">
        <% @messages.each do |message| %>
                <% if message.user == current_user %>
                        <div class="flex flex-col self-end w-[50%] bg-gray-200 rounded-lg p-2">
                            <h1 class="text-black text-md">Sender: <%= message.user.username %></h1>
                            <h1 class="text-black font-medium text-3xl"><%= message.content %></h1>
                            <% if message.image.attached? %><%= image_tag message.image,class:"w-50" %><% end %>
                        </div>
                <% end %>
                <% if message.user != current_user %>
                        <div class="flex flex-col self-start w-[50%] bg-gray-200 rounded-lg p-2">
                            <h1 class="text-black text-md">Sender: <%= message.user.username %></h1>
                            <h1 class="text-black font-medium text-3xl"><%= message.content %></h1>
                            <% if message.image.attached? %><%= image_tag message.image,class:"w-50" %><% end %>
                        </div>
                <% end %>
            
        <% end %>
</div>
</main>