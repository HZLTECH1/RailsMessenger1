<h2 class="text-orange-500 font-medium text-3xl">Sign up</h2>
<main class="grid grid-cols-2">
  <div class="flex flex-col items-center">
  <h1 class="text-3xl text-orange-500 font-medium mb-2">Users:</h1>
  <% @users.each do |user| %>
    <div class="flex flex-row items-center">
    <h1 class="text-white font-medium text-3xl"><%= user.id %>:</h1>
    <h1 class="text-white font-medium text-3xl"><%= user.username %></h1></div>
  <% end %>
  </div>
  <div>
  <%= form_with(url: "/users", model: User) do |form| %>
      <div class="flex flex-col justify-self-center text-2xl gap-y-3">
          <div class="flex flex-col text-left gap-y-3">
              <%= form.label :username, "Username:", class:"text-orange-500 cursor-pointer" %>
              <%= form.text_field :username, required:true, autofocus:true, class:"border-1 rounded-md border-orange-500 outline-none text-white p-2" %>
          </div>
          <div class="flex flex-col text-left gap-y-3">
              <%= form.label :password,"Password:", class: "text-orange-500 cursor-pointer" %>
              <%= form.text_field :password, class:"border-1 rounded-md border-orange-500 outline-none text-white p-2" %>
          </div>
          <div class="flex flex-col text-left gap-y-3">
              <%= form.label :password_confirmation,"Password Confirmation:", class: "text-orange-500 cursor-pointer" %>
              <%= form.text_field :password_confirmation, class:"border-1 rounded-md border-orange-500 outline-none text-white p-2" %>
          </div>
          <%= form.submit "Sign Up", class:"rounded-md text-orange-500 text-3xl font-semibold bg-white cursor-pointer p-1" %>
      </div>
  <% end %>
  </div>
  </main>