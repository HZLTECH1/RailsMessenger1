<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Rails Messenger" %></title>

    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Rails Messenger">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
  </head>

  <body class="bg-blue-950 p-3">
    <div class="flex flex-row gap-x-3 items-center mb-3">
      <div class="flex flex-row gap-x-3">
        <%= link_to "Sign Up", new_user_registration_path, class:"cursor-pointer bg-orange-500 text-white p-1 rounded-md" %>
        <%= link_to "Log In", new_user_session_path, class:"cursor-pointer bg-orange-500 text-white p-1 rounded-md" %>
        <%= button_to "Log Out", destroy_user_session_path, class:"cursor-pointer bg-orange-500 text-white p-1 rounded-md", method: :delete %>
      </div>
      <% if user_signed_in? %><h1 class="text-orange-500 font-medium text-3xl">Currently Logged In As: <%= current_user.username %></h1><% else %><h1 class="text-orange-500 font-medium text-3xl">Not Logged In!</h1><% end %>
    </div>
      <% if flash[:message_creation_success] %><h1 class="mb-3 text-green-600 font-bold text-3xl"><%= flash[:message_creation_success] %></h1><% end %>
      <% if flash[:message_creation_fail] %><h1 class="mb-3 text-red-600 font-bold text-3xl"><%= flash[:message_creation_fail] %></h1><% end %>
      <%= yield %>
  </body>
</html>